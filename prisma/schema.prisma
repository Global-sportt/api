generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupScope {
  global
  establishment
}

enum PermissionScope {
  own
  establishment
  platform
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum EstablishmentStatus {
  pending
  active
  suspended
}

enum SpaceStatus {
  active
  inactive
  maintenance
}

enum BookingStatus {
  pending_payment
  confirmed
  checked_in
  completed
  cancelled
  expired
  no_show
}

enum UserStatus {
  active
  suspended
  deleted
}

enum VerificationTokenType {
  verify_email
  reset_password
}

enum AuthEventType {
  register
  email_verified
  login_succeeded
  login_failed
  login_blocked
  login_locked
  refresh_succeeded
  refresh_reuse_detected
  logout
  password_reset_requested
  password_reset_succeeded
  password_changed
  password_change_failed
  oauth_login_succeeded
  oauth_login_failed
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            Profile?
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]
  authEvents         AuthEvent[]
  memberships        Membership[]
  globalGroups       UserGlobalGroup[]
  bookingsAsPlayer   Booking[]           @relation("BookingPlayer")
  bookingsCreated    Booking[]           @relation("BookingCreatedBy")
  dayClosesClosed    DayClose[]          @relation("DayCloseClosedBy")
  dayClosesReopened  DayClose[]          @relation("DayCloseReopenedBy")

  @@index([status])
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  phone       String?
  locale      String   @default("es-CO")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason")
  ipHash            String?   @map("ip_hash")
  userAgent         String?   @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt            DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String
  providerAccountId String    @map("provider_account_id")
  email             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
  @@map("oauth_accounts")
}

model OAuthState {
  id           String    @id @default(uuid()) @db.Uuid
  stateHash    String    @unique @map("state_hash")
  provider     String
  codeVerifier String    @map("code_verifier")
  nonce        String
  returnTo     String    @map("return_to")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("oauth_states")
}

model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash")
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model AuthEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  type           AuthEventType
  identifierHash String?       @map("identifier_hash")
  ipHash         String?       @map("ip_hash")
  userAgent      String?       @map("user_agent")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, type, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("auth_events")
}

model Permission {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique
  resource      String
  action        String
  allowedScopes PermissionScope[] @map("allowed_scopes")
  isSensitive   Boolean           @default(false) @map("is_sensitive")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  groups SecurityGroupPermission[]

  @@map("permissions")
}

model SecurityGroup {
  id              String     @id @default(uuid()) @db.Uuid
  establishmentId String?    @map("establishment_id") @db.Uuid
  slug            String
  name            String
  scope           GroupScope
  isSystem        Boolean    @default(false) @map("is_system")
  // Identificador estable e inmutable de los grupos de sistema. No usar
  // `slug` para decisiones de autorización: el slug es editable. Los valores
  // válidos y su correspondencia con `scope` los fija el check
  // `security_groups_system_key_check` (migración authz_system_key_guards).
  systemKey       String?    @map("system_key")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  establishment    Establishment?            @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  permissions      SecurityGroupPermission[]
  userGlobalGroups UserGlobalGroup[]
  membershipGroups MembershipGroup[]

  // Prisma no puede expresar índices parciales. En PostgreSQL la unicidad
  // real son dos índices parciales creados a mano (global por slug y tenant
  // por establishment_id+slug); este @@unique se mantiene para el cliente
  // Prisma y NO debe usarse para generar migraciones sin revisar el SQL.
  // Ver docs/adr/ADR-016-db-constraints-manual-sql.md.
  @@unique([establishmentId, slug])
  @@unique([id, scope])
  @@unique([id, establishmentId])
  @@index([scope])
  @@map("security_groups")
}

model SecurityGroupPermission {
  groupId      String          @map("group_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope

  group      SecurityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
  @@index([permissionId])
  @@map("security_group_permissions")
}

model Establishment {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  timezone           String              @default("America/Bogota")
  currency           String              @default("COP")
  address            String?
  contactPhone       String?             @map("contact_phone")
  contactEmail       String?             @map("contact_email")
  cancellationPolicy String?             @map("cancellation_policy")
  usagePolicy        String?             @map("usage_policy")
  rules              String?
  status             EstablishmentStatus @default(pending)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  securityGroups SecurityGroup[]
  memberships    Membership[]
  spaces         Space[]
  bookings       Booking[]
  dayCloses      DayClose[]

  @@map("establishments")
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  establishmentId String           @map("establishment_id") @db.Uuid
  status          MembershipStatus @default(invited)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  groups        MembershipGroup[]

  @@unique([userId, establishmentId])
  @@unique([id, establishmentId])
  @@index([establishmentId, status])
  @@map("memberships")
}

model UserGlobalGroup {
  userId     String     @map("user_id") @db.Uuid
  groupId    String     @map("group_id") @db.Uuid
  groupScope GroupScope @default(global) @map("group_scope")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group SecurityGroup @relation(fields: [groupId, groupScope], references: [id, scope], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_global_groups")
}

model MembershipGroup {
  membershipId    String @map("membership_id") @db.Uuid
  groupId         String @map("group_id") @db.Uuid
  establishmentId String @map("establishment_id") @db.Uuid

  membership Membership    @relation(fields: [membershipId, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  group      SecurityGroup @relation(fields: [groupId, establishmentId], references: [id, establishmentId], onDelete: Cascade)

  @@id([membershipId, groupId])
  @@map("membership_groups")
}

model AuthorizationVersion {
  id        Int      @id @default(1)
  version   BigInt   @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("authorization_versions")
}

model Space {
  id              String      @id @default(uuid()) @db.Uuid
  establishmentId String      @map("establishment_id") @db.Uuid
  name            String
  slug            String
  sport           String?
  slotMinutes     Int         @default(60) @map("slot_minutes")
  bufferMinutes   Int         @default(0) @map("buffer_minutes")
  basePriceMinor  BigInt?     @map("base_price_minor")
  status          SpaceStatus @default(active)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  establishment  Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  operatingHours OperatingHour[]
  exceptions     ScheduleException[]
  priceRules     PriceRule[]
  bookings       Booking[]           @relation("BookingSpace")
  bookingsTenant Booking[]           @relation("BookingSpaceTenant")

  @@unique([establishmentId, slug])
  // Composite key used by bookings FK (space_id, establishment_id): a space
  // can never be referenced with another establishment's id.
  @@unique([id, establishmentId])
  @@index([establishmentId, status])
  @@map("spaces")
}

model OperatingHour {
  id              String @id @default(uuid()) @db.Uuid
  spaceId         String @map("space_id") @db.Uuid
  dayOfWeek       Int    @map("day_of_week")
  opensAtMinutes  Int    @map("opens_at_minutes")
  closesAtMinutes Int    @map("closes_at_minutes")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, dayOfWeek])
  @@map("operating_hours")
}

model ScheduleException {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @map("space_id") @db.Uuid
  date            DateTime @db.Date
  isClosed        Boolean  @default(false) @map("is_closed")
  opensAtMinutes  Int?     @map("opens_at_minutes")
  closesAtMinutes Int?     @map("closes_at_minutes")
  reason          String?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, date])
  @@map("schedule_exceptions")
}

model PriceRule {
  id              String @id @default(uuid()) @db.Uuid
  spaceId         String @map("space_id") @db.Uuid
  dayOfWeek       Int?   @map("day_of_week")
  startsAtMinutes Int    @map("starts_at_minutes")
  endsAtMinutes   Int    @map("ends_at_minutes")
  amountMinor     BigInt @map("amount_minor")
  currency        String @default("COP")
  priority        Int    @default(0)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, dayOfWeek])
  @@map("price_rules")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  publicCode      String        @unique @map("public_code")
  establishmentId String        @map("establishment_id") @db.Uuid
  spaceId         String        @map("space_id") @db.Uuid
  playerId        String        @map("player_id") @db.Uuid
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  status          BookingStatus @default(confirmed)
  totalMinor      BigInt        @map("total_minor")
  currency        String
  idempotencyKey  String?       @map("idempotency_key")
  requestHash     String?       @map("request_hash")
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  // FK simple histórica (Prisma) y FK compuesta de aislamiento multi-sede
  // modelada aparte para que `prisma migrate diff` no la elimine. Ambas
  // existen en la migración 20261127020000_bookings.
  space         Space         @relation("BookingSpace", fields: [spaceId], references: [id], onDelete: Cascade)
  spaceTenant   Space         @relation("BookingSpaceTenant", fields: [spaceId, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  player        User          @relation("BookingPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([createdByUserId, idempotencyKey])
  @@index([spaceId, startsAt])
  @@index([playerId, startsAt])
  @@index([establishmentId, startsAt])
  @@index([status, expiresAt])
  @@map("bookings")
}

/// Foto congelada del cierre diario de una sede. La unicidad
/// (establishment_id, date) impide dos cierres del mismo día local; un cierre
/// reabierto conserva el registro y se actualiza al volver a cerrar.
model DayClose {
  id               String    @id @default(uuid()) @db.Uuid
  establishmentId  String    @map("establishment_id") @db.Uuid
  date             DateTime  @db.Date
  closedAt         DateTime  @map("closed_at") @db.Timestamptz(6)
  closedByUserId   String    @map("closed_by_user_id") @db.Uuid
  reopenedAt       DateTime? @map("reopened_at") @db.Timestamptz(6)
  reopenedByUserId String?   @map("reopened_by_user_id") @db.Uuid
  bookingsCount    Int       @map("bookings_count")
  noShowCount      Int       @map("no_show_count")
  cancelledCount   Int       @map("cancelled_count")
  totalMinor       BigInt    @map("total_minor")
  currency         String

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  // El actor del cierre y de la reapertura son evidencia de auditoría: no se
  // borran en cascada con el usuario.
  closedBy      User                 @relation("DayCloseClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  reopenedBy    User?                @relation("DayCloseReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  spaceTotals   DayCloseSpaceTotal[]

  @@unique([establishmentId, date])
  @@map("day_closes")
}

/// Totales congelados por espacio dentro de un cierre diario. Se eliminan y
/// recrean al re-cerrar un día reabierto.
///
/// `space_id` no lleva FK a `spaces` a propósito: la foto es inmutable y debe
/// sobrevivir al borrado del espacio. Una FK con RESTRICT impediría borrar la
/// sede (la cascada de `spaces` choca con las filas históricas) y con CASCADE
/// borraría totales contables.
model DayCloseSpaceTotal {
  id            String @id @default(uuid()) @db.Uuid
  dayCloseId    String @map("day_close_id") @db.Uuid
  spaceId       String @map("space_id") @db.Uuid
  bookingsCount Int    @map("bookings_count")
  noShowCount   Int    @map("no_show_count")
  totalMinor    BigInt @map("total_minor")

  dayClose DayClose @relation(fields: [dayCloseId], references: [id], onDelete: Cascade)

  @@unique([dayCloseId, spaceId])
  @@map("day_close_space_totals")
}
